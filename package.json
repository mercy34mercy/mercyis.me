{
  "name": "apple-yagi.me",
  "private": true,
  "sideEffects": false,
  "main": "build/index.js",
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "build": "pnpm run \"/^build:.*/\"",
    "build:remix": "remix build",
    "build:css": "tailwindcss -m -i app/styles/app.css -o app/styles/generated.css",
    "deploy": "pnpm run build && wrangler publish",
    "dev:remix": "remix watch",
    "dev:miniflare": "cross-env NODE_ENV=development wrangler dev --local",
    "dev:css": "tailwindcss -w -i app/styles/app.css -o app/styles/generated.css",
    "dev": "pnpm run build && pnpm run \"/^dev:.*/\"",
    "api:build": "aspida",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app --fix --ext ts,tsx",
    "format": "rome format app --write",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@aspida/fetch": "1.11.0",
    "@cloudflare/kv-asset-handler": "0.3.0",
    "@remix-run/cloudflare": "1.14.3",
    "@remix-run/cloudflare-workers": "1.14.3",
    "@remix-run/react": "1.14.3",
    "aspida": "1.11.0",
    "cross-env": "7.0.3",
    "microcms-js-sdk": "2.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "xml2js": "0.4.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20230321.0",
    "@remix-run/dev": "1.14.3",
    "@remix-run/eslint-config": "1.14.3",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "@types/xml2js": "0.4.11",
    "autoprefixer": "10.4.14",
    "concurrently": "8.0.1",
    "eslint": "8.37.0",
    "eslint-plugin-react": "7.32.2",
    "lint-staged": "13.2.0",
    "miniflare": "2.13.0",
    "postcss": "8.4.21",
    "rome": "12.0.0",
    "tailwindcss": "3.3.1",
    "typescript": "5.0.2",
    "webpack": "5.77.0",
    "wrangler": "2.13.0",
    "xo": "0.53.1"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=7.29.1"
  }
}
